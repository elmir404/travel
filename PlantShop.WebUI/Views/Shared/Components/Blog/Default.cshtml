<!--Start Blogs-->
@model List<GetBlogDto>
@inject IViewLocalizer Localizer
@{
	

	var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
	var context = Context.Request;
	var url = context.Path + context.QueryString;


}
<section class="blogs-section bg-flat6 pb120 pt120">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-8">
				<div class="common-heading-2">
					<span class="text-effect-1">@Localizer["Header"]</span>
					<h2 class="mb30">@Localizer["Title"]</h2>
				</div>
			</div>
		</div>
		<div class="row">
			@foreach (var blog in Model)
			{
				<div class="col-lg-4 mt30">
				<div class="single-blog-post- up-hor shdo">
					<div class="single-blog-img-">
						@if(blog.BlogFiles.Count()>0){
								<a href="#"><img src="@blog.BlogFiles.FirstOrDefault().Path" alt="@blog.BlogFiles.FirstOrDefault().FileName" class="img-fluid" /></a>

						}
					</div>
					<div class="blog-content-tt pt20">
						<div class="single-blog-info-">
								@if (culture == "az")
								{
									<h4><a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.AzTitle</a></h4>
									<p style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">@Html.Raw(blog.AzDescription)</p>
								}
								else if (culture == "en")
								{
									<h4><a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.EnTitle</a></h4>
									<p style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">@Html.Raw(blog.EnDescription)</p>
								}
								else if (culture == "vi")
								{
									<h4><a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.ViTitle</a></h4>
									<p style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">@Html.Raw(blog.ViDescription)</p>
								}
								else
								{
									<h4><a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.JpTitle</a></h4>
									<p style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">@Html.Raw(blog.JpDescription)</p>
								}
							
						</div>
						<div class="post-social">
							<div class="ss-inline-share-content">
								<div class="ss-social-icons-container">
									<a href="javascript:void(0)">@Localizer["Share"]:</a>
										<a href="https://www.facebook.com/sharer.php?u=https://sakuragfbgroup.com/blog/@@blog.Slug" target="blank"><i class="fab fa-facebook"></i></a>
										<a href="https://twitter.com/intent/tweet?url=&quot;https://sakuragfbgroup.com/blog/@@blog.Slug&quot;&amp;text=@@blog.EnTitle" target="blank"><i class="fab fa-twitter"></i></a>
										<a href="http://www.linkedin.com/shareArticle?mini=true&amp;url=https://sakuragfbgroup.com/blog/@@blog.Slug" target="blank"><i class="fab fa-linkedin"></i></a>
										<a href="mailto:?subject=I wanted you to see this site&amp;amp;body=Check out this site https://sakuragfbgroup.com/blog/@@blog.Slug" target="blank"><i class="fas fa-envelope"></i></a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			}
			
			

		</div>
	</div>
</section>
<!--End Blogs-->
