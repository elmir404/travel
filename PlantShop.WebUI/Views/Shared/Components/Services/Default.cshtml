<!--Start work-category-->
@inject IViewLocalizer Localizer
<section class="work-category pad-tb tilt3d">
	<div class="container">
		<div class="row">
			<div class="col-lg-4 v-center">
				<div class="common-heading text-l">
					<span>@Localizer["Header"]</span>
					<h2>@Localizer["Title"]</h2>
					<p>@Localizer["Description"]</p>
				</div>
			</div>
			<div class="col-lg-8">
				<div class="work-card-set">
					<div class="icon-set wow fadeIn" data-wow-delay=".2s">
						<div class="work-card cd1">
							<div class="icon-bg"><img src="~/images/icons/volunteer.png" alt="@Localizer["Work"]" /></div>
							<p>@Localizer["Work"]</p>
						</div>
					</div>
					
					<div class="icon-set wow fadeIn" data-wow-delay=".6s">
						<div class="work-card cd3">
							<div class="icon-bg"><img src="images/icons/logistics.png" alt="@Localizer["Logicstics"]" /></div>
							<p>@Localizer["Logicstics"]</p>
						</div>
					</div>
					
				
					<div class="icon-set wow fadeIn" data-wow-delay="1.2s">
						<div class="work-card cd6">
							<div class="icon-bg"><img src="images/icons/service.png" alt="@Localizer["Law"]" /></div>
							<p>@Localizer["Law"]</p>
						</div>
					</div>
					<div class="icon-set wow fadeIn" data-wow-delay="1.4s">
						<div class="work-card cd7">
							<div class="icon-bg"><img src="images/icons/icon-7.png" alt="@Localizer["Education"]" /></div>
							<p>@Localizer["Education"]</p>
						</div>
					</div>
					<div class="icon-set wow fadeIn" data-wow-delay="1.6s">
						<div class="work-card cd8">
							<div class="icon-bg"><img src="images/icons/icon-8.png" alt="Tour and Travels" /></div>
							<p>@Localizer["Travel"]</p>
						</div>
					</div>
					<div class="icon-set wow fadeIn" data-wow-delay="2.4s">
						<div class="work-card cd12">
							<div class="icon-bg"><img src="images/icons/icon-12.png" alt="@Localizer["Consalting"]" /></div>
							<p>@Localizer["Consalting"]</p>
						</div>
					</div>
					<div class="icon-set wow fadeIn" data-wow-delay="2.4s">
						<div class="work-card cd2">
							<div class="icon-bg"><img src="images/icons/skin-care.png" alt="@Localizer["Beauty"]" /></div>
							<p>@Localizer["Beauty"]</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!--End  work-category-->