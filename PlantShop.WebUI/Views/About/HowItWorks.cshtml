@{
    ViewData["Title"] = "Necə İşləyir?";
}
@section Styles{
    <style>
    


.timeline-page {
    padding: 10px 0;
    position: relative;
    margin-top: 35px;
}

.timeline-page::after {
    content: "";
    height: 95%;
    left: 0;
    margin: auto;
    position: absolute;
    right: 0;
    top: 0;
    width: 1px;
    background-color: #e8e8e8;
}

.timeline-item {
    margin-bottom: 80px;
}

.timeline-page .timeline-item .date-label-left {
    text-align: center;
    margin-right: 20px;
    position: relative;
}

.timeline-page .timeline-item .date-label-left::after,
.timeline-page .timeline-item .duration-right::after {
    border: 3px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    content: "";
    height: 20px;
    position: absolute;
    top: 20px;
    width: 20px;
    z-index: 1;
}

.timeline-page .timeline-item .date-label-left::after {
    right: -45px;
}

.timeline-page .timeline-item .duration-right::after {
    left: -45px;
}

.timeline-page .timeline-item .works-description-right {
    text-align: left;
    margin-left: 15px;
    float: left;
    border-radius: 0;
    padding: 20px 0;
}

.timeline-page .timeline-item .duration-right {
    text-align: center;
    margin-left: 20px;
    position: relative;
}

.timeline-page .timeline-item .works-description-left {
    text-align: right;
    margin-right: 15px;
    float: right;
    border-radius: 0;
    padding: 20px 0;
}

.timeline-page h4,
.works-description-left h4 {
    font-size: 18px;
    margin-top: 0;
    text-transform: capitalize;
}

.timeline-subtitle {
    line-height: 26px;
    color: #666;
}

.bg-custom, .btn-custom, .timeline-page .timeline-item .date-label-left::after, .timeline-page .timeline-item .duration-right::after, .back-to-top:hover {
    background-color: #f6576e;
}
    </style>
}
<div class="container">
    <div class="row justify-content-center text-center">
        <div class="col-lg-12">
            <h1 class="font-900">Necə sifariş etməli?</h1>
            <p class="text-muted mt-4 title-subtitle mx-auto">Bu bölmədə məhsulların sifarişi prosesi ilə bağlı məlumat ala bilərsiniz.</p>
        </div>
    </div>
    <div class="timeline-page mt-5">
        <div class="timeline-item">
            <div class="row">
                <div class="col-lg-6">
                    <div class="duration date-label-left">
                        <img src="~/images/step1.png" alt="Necə sifariş etməli?" class="img-fluid">
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="works works-description-right">
                        <h4>Sifarişin Təsdiqlənməsi</h4>
                        <p class="timeline-subtitle">Səbətinizə əlavə etdiyiniz məhsulları görmək üçün ekranın sol yuxarı küncündə olan səbət işarəsinə klikləyə bilərsiniz.Əgər məhsul seçiminiz tamamlandısa "Sifariş Et" butonunu klikləyə bilərsiniz.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="timeline-item">
            <div class="row">
                <div class="col-lg-6">
                    <div class="works works-description-left">
                        <h4>Əlaqə Məlumatları</h4>
                        <p class="timeline-subtitle">Keçid etdiyiniz bölmədə sizdən çatdırılma üçün əlaqə məlumatlarınız tələb olunur.Zəhmət olmasa prosesin tamamlanması üçün məlumatları doğru daxil edin.Əlavə olaraq sifarişinizlə bağlı xüsusi qeydiniz varsa burada "mesaj" bölməsinə qeyd edə bilərsiniz.</p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="duration duration-right ">
                        <img src="~/images/step2.png" alt="Əlaqə Məlumatları" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>
        <div class="timeline-item">
            <div class="row">
                <div class="col-lg-6">
                    <div class="duration date-label-left">
                        <img src="~/images/step3.png" alt="Telefon Nömrəsi Təsdiqi" class="img-fluid">
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="works works-description-right">
                        <h4>Telefon Nömrəsi Təsdiqi</h4>
                        <p class="timeline-subtitle">Telefon nömrənizi təsdiq etməniz üçün sizə təsdiq şifrəsi göndəriləcək.Şifrəni düzgün daxil edin və "Şifrəni Təsdiqlə" butonuna klikləyin.Təbriklər!Sifarişiniz təsdiq olundu,əməkdaşlarımız sizinlə ən qısa zamanda əlaqə yaradacaq.Çatdırılma zamanı qeyd olunan promokoda özəl endirimlərdən yaralanmaq üçün kodu əməkdaşa deməyi unutmayın!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>