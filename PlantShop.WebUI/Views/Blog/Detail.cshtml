@model GetBlogDto
@{
	

		var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
    @if (culture == "az")
    {
        ViewData["Title"] = Model.AzTitle;
    }
    else if (culture == "en")
    {
        ViewData["Title"] = Model.EnTitle;
    }
    else if (culture == "vi")
    {
        ViewData["Title"] = Model.ViTitle;
    }
    else
    {
        ViewData["Title"] = Model.JpTitle;
    }
    
		
 
}

<!--Breadcrumb Area-->
<section class="breadcrumb-area banner-2">
    <div class="text-block">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 v-center">
                    <div class="bread-inner">
                        <div class="bread-menu">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                                <li><a >Blog Details</a></li>
                            </ul>
                        </div>
                        <div class="bread-title">
                              @if (culture == "az")
                            {
                                <h2>@Model.AzTitle</h2>
                            }
                            else if (culture == "en")
                            {
                                <h2>@Model.EnTitle</h2>
                            }
                            else if (culture == "vi")
                            {
                                <h2>@Model.ViTitle</h2>
                            }
                            else
                            {
                                <h2>@Model.JpTitle</h2>
                            }
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--End Breadcrumb Area-->
<!--Start Blog Details-->
<section class="blog-page pad-tb">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="blog-header">
                    @if (culture == "az")
                    {
                        <h1>@Model.AzTitle</h1>
                    }
                    else if (culture == "en")
                    {
                        <h1>@Model.EnTitle</h1>
                    }
                    else if (culture == "vi")
                    {
                        <h1>@Model.ViTitle</h1>
                    }
                    else
                    {
                        <h1>@Model.JpTitle</h1>
                    }
                   
                  
                </div>
                <div class="image-set">
                    @if(Model.BlogFiles.Count()>0){
                        <img src="/@Model.BlogFiles.FirstOrDefault().Path" alt="@Model.BlogFiles.FirstOrDefault().FileName" class="img-fluid" />

                    }
                    </div>
                <div class="blog-content mt30">
                    @if (culture == "az")
                    {
                        <p>
                           @Html.Raw(Model.AzDescription)
                        </p>
                    }
                    else if (culture == "en")
                    {
                        <p>
                            @Html.Raw(Model.EnDescription)
                        </p>
                    }
                    else if (culture == "vi")
                    {
                        

                    <p>
                            @Html.Raw(Model.ViDescription)
                        </p>
                    }
                    else
                    {
                        <p>
                            @Html.Raw(Model.JpDescription)
                        </p>
                    }
                   
                   

                    <div class="row">
                       
                        <div class="col-lg-4 col-md-4 mt30 mb30">
                            <div class="blog-share-icon text-left text-md-right">
                                <span>Share: </span>
                               <a href="https://www.facebook.com/sharer.php?u=https://sakuragfbgroup.com/blog/@@blog.Slug" target="blank"><i class="fab fa-facebook"></i></a>
											<a href="https://twitter.com/intent/tweet?url=&quot;https://sakuragfbgroup.com/blog/@@blog.Slug&quot;&amp;text=@@blog.EnTitle" target="blank"><i class="fab fa-twitter"></i></a>
											<a href="http://www.linkedin.com/shareArticle?mini=true&amp;url=https://sakuragfbgroup.com/blog/@@blog.Slug" target="blank"><i class="fab fa-linkedin"></i></a>
											<a href="mailto:?subject=I wanted you to see this site&amp;amp;body=Check out this site https://sakuragfbgroup.com/blog/@@blog.Slug" target="blank"><i class="fas fa-envelope"></i></a>
                            </div>
                        </div>
                    </div>
                   

                </div>
              
            </div>
            <!--End Blog Details-->
           
        </div>
    </div>
</section>


