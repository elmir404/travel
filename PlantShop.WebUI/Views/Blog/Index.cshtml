@model List<GetBlogDto>
@inject IViewLocalizer Localizer
@{
	ViewData["Title"] = "Sakura GFB Group:";

		var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
		var context = Context.Request;
		var url = context.Path + context.QueryString;
	
 
}

<!--Breadcrumb Area-->
<section class="breadcrumb-area banner-2">
	<div class="text-block">
		<div class="container">
			<div class="row">
				<div class="col-lg-12 v-center">
					<div class="bread-inner">
						<div class="bread-menu">
							<ul>
								<li><a href="index.html">@Localizer["Home"]</a></li>
								<li><a href="#">@Localizer["PageHeader"]</a></li>
							</ul>
						</div>
						<div class="bread-title">
							<h2>@Localizer["PageTitle"]</h2>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!--End Breadcrumb Area-->
<!--Start Blog Grid-->
<section class="blog-page pad-tb pt40">
	<div class="container">

		<div class="row">

			@foreach (var blog in Model)
			{
				<div class="col-lg-4 mt60">
				<div class="single-blog-post- shdo">
					<div class="single-blog-img-">
						<a href="#">
							@if(blog.BlogFiles.Count()>0){
									<img src="/@blog.BlogFiles.FirstOrDefault().Path" alt="@blog.BlogFiles.FirstOrDefault().FileName" class="img-fluid">

							}
							</a>
						<div class="entry-blog-post dg-bg2">
								
								
									<span class="posted-on-">
										<a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@Localizer["PageTitle"]</a>
									</span>
								
								
						</div>
					</div>
					<div class="blog-content-tt">
						<div class="single-blog-info-">
								@if (culture == "az")
								{
									<h4><a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.AzTitle</a></h4>
									<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
								}
								else if (culture == "en")
								{
									<h4><a asp-action ="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.EnTitle</a>

									</h4>
									<p>@blog.EnDescription</p>
								}
								else if (culture == "vi")
								{
									<h4><a asp-action="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.ViTitle</a></h4>
									<p>@blog.ViDescription</p>
								}
								else
								{
									<h4><a asp-action ="Detail" asp-controller="Blog" asp-route-slug="@blog.Slug">@blog.JpTitle</a>

									</h4>
									<p>@blog.JpDescription</p>
								}
			
						</div>
						<div class="post-social">
							<div class="ss-inline-share-wrapper ss-hover-animation-fade ss-inline-total-counter-left ss-left-inline-content ss-small-icons ss-with-spacing ss-circle-icons ss-without-labels">
								<div class="ss-inline-share-content">
									<div class="ss-social-icons-container">
										<a href="javascript:void(0)">@Localizer["Share"]:</a>
										<a href="javascript:void(0)" target="blank"><i class="fab fa-facebook"></i></a>
										<a href="javascript:void(0)" target="blank"><i class="fab fa-twitter"></i></a>
										<a href="javascript:void(0)" target="blank"><i class="fab fa-linkedin"></i></a>
										<a href="javascript:void(0)" target="blank"><i class="fas fa-envelope"></i></a>
										<a href="javascript:void(0)" target="blank"><i class="fab fa-facebook-messenger"></i></a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			}
			

			


		</div>

	</div>
</section>
<!--End Blog Grid-->
