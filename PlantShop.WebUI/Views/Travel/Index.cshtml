@inject IViewLocalizer Localizer
<section class="breadcrumb-area banner-1" data-background="~/images/banner/9.jpg">
    <div class="text-block">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 v-center">
                    <div class="bread-inner">
                        <div class="bread-menu">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                                <li><a asp-controller="About" asp-action="Index">@Localizer["AboutUs"]</a></li>
                            </ul>
                        </div>
                        <div class="bread-title">
                            <h2>@Localizer["About"]</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
