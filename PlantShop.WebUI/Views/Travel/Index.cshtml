@inject IViewLocalizer Localizer
@section Style{
    <style>
        .custom-nav .nav-list li a.menu-links{
            color: #ffff;
        }
        @@media (min-width: 1200px){
            .container, .container-lg, .container-md, .container-sm, .container-xl {
                max-width: 1400px;
            }
        }
    </style>
}
<section class="hero-section hero-digital-agency-1 branding-agency video-bg-">
    <img class="full-video" data-mask="3" src="~/images/hero/japon.jpg" autoplay="" muted="" loop="">
    <div class="text-block niwax" data-rellax-speed="-3">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-9 v-center">
                    <div class="header-heading">
                        <h1 class="wow fadeInUp text-effect-1" data-wow-delay=".2s">We Build Scalable & Smart Solution</h1>
                        <p class="wow fadeInUp" data-wow-delay=".4s">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse faucibus, risus sit amet auctor sodales, justo erat tempor eros.</p>
                        <a asp-action="Index" asp-controller="Contact" class="btn-main bg-btn4 lnk wow fadeInUp" data-wow-delay=".6s">@Localizer["link"]<i class="fas fa-chevron-right fa-icon"></i><span class="circle"></span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
