@model GetSliderDto
@inject IViewLocalizer Localizer
@{


    var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
   


}
@section Style{
    <style>
        .custom-nav .nav-list li a.menu-links{
            color: #ffff;
        }
        @@media (min-width: 1200px){
            .container, .container-lg, .container-md, .container-sm, .container-xl {
                max-width: 1400px;
            }
        }
    </style>
}
<section class="hero-section hero-digital-agency-1 branding-agency video-bg-">
    @if (@Model.SliderFiles.Count() > 0)
    {
        <img class="full-video" data-mask="3" src="@Model.SliderFiles[0].Path" alt="@Model.SliderFiles[0].FileName" autoplay="" muted="" loop="">

    }
    <div class="text-block niwax" data-rellax-speed="-3">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-9 v-center">
                    <div class="header-heading">
                       
                        @if (culture == "az")
                        {
                            <h1 class="wow fadeInUp text-effect-1" data-wow-delay=".2s">@Model.AzTitle</h1>
                            <p class="wow fadeInUp" data-wow-delay=".4s">@Model.AzDescription</p>
                        }
                        @if (culture == "en")
                        {
                            <h1 class="wow fadeInUp text-effect-1" data-wow-delay=".2s">@Model.EnTitle</h1>
                            <p class="wow fadeInUp" data-wow-delay=".4s">@Model.EnDescription</p>
                        }
                        @if (culture == "ru")
                        {
                            <h1 class="wow fadeInUp text-effect-1" data-wow-delay=".2s">@Model.RuTitle</h1>
                            <p class="wow fadeInUp" data-wow-delay=".4s">@Model.RuDescription</p>
                        }
                        @if (culture == "vi")
                        {
                            <h1 class="wow fadeInUp text-effect-1" data-wow-delay=".2s">@Model.ViTitle</h1>
                            <p class="wow fadeInUp" data-wow-delay=".4s">@Model.ViDescription</p>
                        }
                        @if (culture == "ja-Jp")
                        {
                            <h1 class="wow fadeInUp text-effect-1" data-wow-delay=".2s">@Model.JpTitle</h1>
                            <p class="wow fadeInUp" data-wow-delay=".4s">@Model.JpDescription</p>
                        }
                        <a asp-action="Index" asp-controller="Contact" class="btn-main bg-btn4 lnk wow fadeInUp" data-wow-delay=".6s">@Localizer["link"]<i class="fas fa-chevron-right fa-icon"></i><span class="circle"></span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="why-choos-lg pad-tb">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="common-heading text-l">
                    <span>@Localizer["TravelHeader"]</span>
                    <h2 class="mb20">@Localizer["TravelTitle"]</h2>
                    <p>@Localizer["Description"]</p>
                    <div class="itm-media-object mt40 tilt-3d">
                        <div class="media">
                            <div class="img-ab- base" data-tilt data-tilt-max="20" data-tilt-speed="1000"><img src="~/images/icons/professional-services.png" alt="icon" class="layer"></div>
                            <div class="media-body">
                                <h4>@Localizer["team-title"]</h4>
                                <p>@Localizer["team-desc"]</p>
                            </div>
                        </div>
                        <div class="media mt40">
                            <div class="img-ab- base" data-tilt data-tilt-max="20" data-tilt-speed="1000"><img src="~/images/icons/review.png" alt="icon" class="layer"></div>
                            <div class="media-body">
                                <h4>@Localizer["hotel-title"]</h4>
                                <p>@Localizer["hotel-dec"]</p>
                            </div>
                        </div>
                        <div class="media mt40">
                            <div class="img-ab- base" data-tilt data-tilt-max="20" data-tilt-speed="1000"> <img src="~/images/icons/family.png" alt="icon" class="layer"></div>
                            <div class="media-body">
                                <h4>@Localizer["family-title"]</h4>
                                <p>@Localizer["family-desc"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="single-image">  </div>
                <div class="cta-card mt60 text-center">
                    <h3>@Localizer["link-title"]</h3>
                    <p>@Localizer["link-description"]</p>
                    <a asp-controller="Contact"  asp-action="Index" class="btn-outline lnk mt30">@Localizer["link"]  <i class="fas fa-chevron-right fa-icon"></i><span class="circle"></span></a>
                </div>
            </div>
        </div>
    </div>
</section>
<!--End About-->
@await Component.InvokeAsync("Blog")
<script>
    //Owl-Carousel - awards card
    var owl = $('.niwax-logo-slider');
    owl.owlCarousel({
          loop: true,
          center:false,
          autoplay: true,
          margin: 20,
          nav: false,
          dots: false,
          autoplayTimeout: 3500,
          autoplayHoverPause: true,
          smartSpeed: 2000,
          responsive: {
                0: {
                    items: 3,
                },
                520: {
                    items: 3
                },
                \
                768: {
                    items: 4
                },
                1200: {
                    items: 4
                },
                1400: {
                    items: 5
                },
                1600: {
                    items: 6
                },
            }
          });
</script>
