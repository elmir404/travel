@model List<GetContactDto>
<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important">
        <!-- Dynamic Table Responsive -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">
                    Message Table <small>List</small>
                </h3>
            </div>
            <div class="block-content block-content-full">
                <table id="message-datatable" class="table table-bordered table-striped table-vcenter js-dataTable-responsive mt-4">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Subject</th>
                            <th style="width: 15%;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in Model)
                        {
                            <tr>
                                <td class="fs-sm">@contact.Name</td>
                                <td class="fw-semibolcod fs-sm">@contact?.Number?.Phone</td>
                                <td class="fw-semibold fs-sm">@contact.Subject</td>
                             
                                <td>
                                    <div class="btn-list">
                                        <button id="@contact.Id" type="button" class="btn remove btn-sm btn-danger"><span class="fa fa-delete"><i class="si si-trash"></i></span></button>
                                        <button id="@contact.Id" type="button" class="btn detail btn-sm btn-info"><span class="fa fa-detail"><i class="fa fa-info-circle"></i></span></button>
                                    </div>
                                   
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Dynamic Table Responsive -->
    </div>
    <!-- END Page Content -->
</main>
@section Scripts{
    <script>
        $('#message-datatable').on('click', '.remove', function () {
            var table = $('#message-datatable').DataTable();
            var id = $(this).attr("id");
            var thh = $(this);
            debugger;
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "PUT",
                        url: `/AdminPanel/Contact/Delete?messageId=${id}`,
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire(
                                    'Deleted!',
                                    'Your file has been deleted.',
                                    'success'
                                ).then((result) => {
                                    if (result.isConfirmed) {
                                        table
                                            .row($(thh).parents('tr'))
                                            .remove()
                                            .draw(false);
                                    }
                                });

                            }
                            else {
                                alert(result.message)
                            }
                        }
                    });

                }
            })

        });
        $('#message-datatable').on('click', '.detail', function () {
            var id = $(this).attr("id");
            location.href = `/AdminPanel/Contact/Detail?messageId=${id}`

        });

    </script>
}