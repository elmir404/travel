@model GetContactDto
<div class="main-content app-content mt-0">
    <div class="side-app">
        <!-- CONTAINER -->
        <div class="main-container container-fluid">
            <!-- ROW-1 OPEN -->
            <div class="row">
                <div class="col-lg-12">
                    <div class="card-body">
                        <div id="updateHome" style="margin-top: 5%">
                            <div class="row mb-4">
                                <label class="col-md-3 form-label">Name :</label>
                                <div class="col-md-9">
                                    <input type="text" asp-for="@Model.Name" class="form-control" disabled style="background-color: white !important">
                                </div>
                            </div>
                            <div class="row mb-4">
                                <label class="col-md-3 form-label">Phone :</label>
                                <div class="col-md-9">
                                    <input type="text" asp-for="@Model.Number" class="form-control" disabled style="background-color: white !important">
                                </div>
                            </div>
                            <div class="row mb-4">
                                <label class="col-md-3 form-label">Email :</label>
                                <div class="col-md-9">
                                    <input type="text" asp-for="@Model.Email" class="form-control" disabled style="background-color: white !important;">
                                </div>
                            </div>
                            <div class="row mb-4">
                                <label class="col-md-3 form-label">Message :</label>
                                <div class="col-md-9">
                                    <textarea type="text" asp-for="@Model.Message" class="form-control" disabled style="background-color: white !important; height: 110px;"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ROW-1 CLOSED -->
        </div>
        <!-- CONTAINER CLOSED -->
    </div>
</div>