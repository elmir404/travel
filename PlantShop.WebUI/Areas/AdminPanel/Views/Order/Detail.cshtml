@model GetOrderDto
@{
    ViewData["Title"] = "Update";
}
<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important;">
        <!-- Horizontal -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">Order Detail</h3>
            </div>
            <div class="block-content block-content-full">
                <div class="row">
                    <div class="col-lg-12 space-y-5">
                        <!-- Form Horizontal - Default Style -->
                        <form class="space-y-4" method="POST">
                           
                            <div class="text-danger mb-2 "></div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Name</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.Name" class="form-control" placeholder="Az Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Phone</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.Number.Phone" class="form-control" placeholder="En Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Email</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.Email" class="form-control" placeholder="Ru Name..">
                                </div>
                            </div> 
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Date</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.RegDate" class="form-control" placeholder="Ru Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Total Up Price</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.TotalUpPrice" class="form-control" placeholder="">
                                </div>
                            </div> 
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Total Price</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.TotalPrice" class="form-control" placeholder="">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Total Percent</label>
                                <div class="col-sm-8">
                                    <input readonly type="text" asp-for="@Model.Inrst" class="form-control" placeholder="Ru Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Products</label>
                                <div class="col-sm-8">
                                    <select >
                                        @foreach (var prod in Model.ProductOrders)
                                        {
                                            <option>ProductId:@prod.ProductId, Name: @prod.ProductName, UpPride:@prod.UpPrice, Perc:@prod.Inrst % Price:@prod.Price, Count:@prod.Count  </option>
                                        }
                                    </select>
                                </div>
                            </div>
                           
                        </form>
                        <!-- END Form Horizontal - Default Style -->
                    </div>
                </div>
            </div>
        </div>
        <!-- END Horizontal -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <style>
        .field-error {
            margin: 0px !important;
            font-style: italic;
            letter-spacing: 1px;
        }
    </style>
}