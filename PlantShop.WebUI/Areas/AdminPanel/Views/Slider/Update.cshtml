@model UpdateSliderDto
@{
    ViewData["Title"] = "Update";
}
<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important;">
        <!-- Horizontal -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">Update Slider</h3>
            </div>
            <div class="block-content block-content-full">
                <div class="row">
                    <div class="col-lg-8 space-y-5">
                        <!-- Form Horizontal - Default Style -->
                        <form class="space-y-4" method="POST" enctype="multipart/form-data">
                            <div class="text-danger mb-2 ">
                                <p class="field-error"><span asp-validation-for="AzTitle" class="text-danger"></span></p>
                                <p class="field-error"><span asp-validation-for="AzDescription" class="text-danger"></span></p>
                                <p class="field-error"><span asp-validation-for="Files" class="text-danger"></span></p>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Title</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.AzTitle" class="form-control">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Title</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.EnTitle" class="form-control">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Title</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.RuTitle" class="form-control">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Title</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.JpTitle" class="form-control">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Title</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.ViTitle" class="form-control">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="@Model.AzDescription" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="@Model.EnDescription" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="@Model.RuDescription" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="@Model.JpDescription" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="@Model.ViDescription" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Photo</label>
                                <div class="col-sm-8">
                                    <input type="file" name="Files" id="Files" class="form-control" accept=" .jpg, .png, image /jpeg, image /png">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-8 ms-auto">
                                    <button type="submit" class="btn btn-primary">Update Slider</button>
                                </div>
                            </div>
                        </form>
                        <!-- END Form Horizontal - Default Style -->
                    </div>
                </div>
            </div>
        </div>
        <!-- END Horizontal -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <style>
        .field-error {
            margin: 0px !important;
            font-style: italic;
            letter-spacing: 1px;
        }
    </style>
}