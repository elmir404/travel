@model AddSliderDto

<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important;">
        <!-- Horizontal -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">Add Slider</h3>
            </div>
            <div class="block-content block-content-full">
                <div class="row">
                    <div class="col-lg-12 space-y-5">
                        <!-- Form Horizontal - Default Style -->
                        <form class="space-y-4" method="POST" enctype="multipart/form-data">
                            <div class="text-danger mb-2 ">
                                <p class="field-error"><span asp-validation-for="AzTitle" class="text-danger"></span></p>
                                <p class="field-error"><span asp-validation-for="AzDescription" class="text-danger"></span></p>
                                <p class="field-error"><span asp-validation-for="Files" class="text-danger"></span></p>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Az Name</label>
                                <div class="col-sm-8">
                                    <input type="text" name="AzTitle" class="form-control" placeholder="Title..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">En Name</label>
                                <div class="col-sm-8">
                                    <input type="text" name="EnTitle" class="form-control" placeholder="Title..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Jp Name</label>
                                <div class="col-sm-8">
                                    <input type="text" name="JpTitle" class="form-control" placeholder="Title..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Ru Name</label>
                                <div class="col-sm-8">
                                    <input type="text" name="RuTitle" class="form-control" placeholder="Title..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Vi Name</label>
                                <div class="col-sm-8">
                                    <input type="text" name="ViTitle" class="form-control" placeholder="Title..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Az Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" name="AzDescription" class="form-control" placeholder="Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">En Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" name="EnDescription" class="form-control" placeholder="Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Ru Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" name="RuDescription" class="form-control" placeholder="Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Jp Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" name="JpDescription" class="form-control" placeholder="Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Vi Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" name="ViDescription" class="form-control" placeholder="Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Photo</label>
                                <div class="col-sm-8">
                                    <input type="file" name="Files" id="Files" class="form-control" accept=".jpg, .png, image/jpeg, image/png">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-8 ms-auto">
                                    <button type="submit" class="btn btn-primary">Add Slider</button>
                                </div>
                            </div>
                        </form>
                        <!-- END Form Horizontal - Default Style -->

                    </div>
                </div>
            </div>
        </div>
        <!-- END Horizontal -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <style>
        .field-error {
            margin: 0px !important;
            font-style: italic;
            letter-spacing: 1px;
        }
    </style>
}