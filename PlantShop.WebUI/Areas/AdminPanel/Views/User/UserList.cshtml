@model List<ApplicationUserDto>
<!--app-content open-->

<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important">
        <!-- Dynamic Table Responsive -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">
                    User Table <small>List</small>
                </h3>
            </div>
            <div class="block-content block-content-full">
                <!-- DataTables init on table by adding .js-dataTable-responsive class, functionality is initialized in js/pages/be_tables_datatables.min.js which was auto compiled from _js/pages/be_tables_datatables.js -->
                <table id="user-datatable" class="table table-bordered table-striped table-vcenter js-dataTable-responsive" style="margin: 10px 0px;">
                    <thead>
                        <tr>
                            <th class="border-bottom-0">Id</th>
                            <th class="border-bottom-0">Username</th>
                            <th class="border-bottom-0">Email</th>
                            <th class="border-bottom-0">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fs-sm">@user.Id</td>
                                <td class="fw-semibold fs-sm">@user.Name @user.Surname</td>
                                <td class="fs-sm">@user.Email</td>
                                <td>
                                    <div class="btn-list">
                                        <button onclick=Edit(@user.Id) type="button" class="btn btn-sm btn-primary">
                                            <i class="si si-menu"></i>
                                        </button>
                                        <button id="@user.Id" type="button" class="btn remove  btn-sm btn-danger">
                                            <span class="si si-trash"> </span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Dynamic Table Responsive -->
    </div>
    <!-- END Page Content -->
</main>
@section Scripts {
    <script>
        function Edit(id) {
            location.href = `/AdminPanel/User/Update?Id=${id}`;
        }
        $('#user-datatable').on('click', '.remove', function () {
            var table = $('#user-datatable').DataTable();
            var id = $(this).attr("id");
            var thh = $(this);

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "PUT",
                        url: `/AdminPanel/User/Delete?userId=${id}`,
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire(
                                    'Deleted!',
                                    'Your file has been deleted.',
                                    'success'
                                ).then((result) => {
                                    if (result.isConfirmed) {
                                        table
                                            .row($(thh).parents('tr'))
                                            .remove()
                                            .draw(false);

                                    }
                                });

                            }
                            else {
                                alert(result.message)
                            }
                        }
                    });

                }
            })


        });
    </script>
 }
