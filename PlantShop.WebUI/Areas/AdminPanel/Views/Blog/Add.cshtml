@model AddBlogDto

<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important;">
        <!-- Horizontal -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">Add Product</h3>
            </div>
            <div class="block-content block-content-full">
                <div class="row">
                    <div class="col-lg-12 space-y-5">
                        <!-- Form Horizontal - Default Style -->
                        <form class="space-y-4" method="POST" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" style="font-style:normal !important" class="text-danger mb-2 validations"></div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Az Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="AzTitle" class="form-control" placeholder="Az Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">En Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="EnTitle" class="form-control" placeholder="En Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Jp Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="JpTitle" class="form-control" placeholder="Jp Name..">
                                </div>
                            </div>
                             <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Vi Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="ViTitle" class="form-control" placeholder="Vi Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Az Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="AzDescription" class="form-control" placeholder="Az Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">En Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="EnDescription" class="form-control" placeholder="En Description.."></textarea>
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Jp Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="JpDescription" class="form-control" placeholder="Japon Description.."></textarea>
                                </div>
                            </div>
                             <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Vi Description</label>
                                <div class="col-sm-8">
                                    <textarea type="text" asp-for="ViDescription" class="form-control" placeholder="Vietnam Description.."></textarea>
                                </div>
                            </div>
                           
                           
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Photo</label>
                                <div class="col-sm-8">
                                    <input type="file" name="Files" id="Files" class="form-control" accept=".jpg, .png, image/jpeg, image/png">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-8 ms-auto">
                                    <button type="submit" class="btn btn-primary">Add Blog</button>
                                </div>
                            </div>
                        </form>
                        <!-- END Form Horizontal - Default Style -->

                    </div>
                </div>
            </div>
        </div>
        <!-- END Horizontal -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <style>
        .validations ul{
            font-style: italic;
            letter-spacing: 1px;
        }
    </style>
}