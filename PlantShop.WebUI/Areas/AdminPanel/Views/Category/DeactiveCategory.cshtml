@{
    ViewData["Title"] = "DeactiveCategory";
}

@model List<GetCategoryDto>
<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important">
        <!-- Dynamic Table Responsive -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">
                    Deactive Category Table <small>List</small>
                </h3>
            </div>
            <div class="block-content block-content-full">
                <!-- DataTables init on table by adding .js-dataTable-responsive class, functionality is initialized in js/pages/be_tables_datatables.min.js which was auto compiled from _js/pages/be_tables_datatables.js -->
                <table id="category-table" class="table table-bordered table-striped table-vcenter js-dataTable-responsive mt-4">
                    <thead>
                        <tr>
                            <th class="text-center">Id</th>
                            <th>Name</th>
                            <th style="width: 15%;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="fs-sm">@category.Id</td>
                                <td class="fw-semibold fs-sm">@category.AzName</td>
                                <td>
                                    <div class="btn-list">
                                        <button id="@category.Id" type="button" class="btn activee btn-primary">Active</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Dynamic Table Responsive -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <script>
        $('#category-table').on('click', '.activee', function () {
            var table = $('#category-table').DataTable();
            var id = $(this).attr("id");
            var thh = $(this);

            Swal.fire({
                title: 'Are you sure?',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, active it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "PATCH",
                        url: `/AdminPanel/Category/Active?Id=${id}`,
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire(
                                    'Actived!',
                                    'Your file has been actived.',
                                    'success'
                                ).then((result) => {
                                    if (result.isConfirmed) {
                                        table
                                            .row($(thh).parents('tr'))
                                            .remove()
                                            .draw(false);

                                    }
                                });
                            }
                            else {
                                alert(result.message)
                            }
                        }
                    });

                }
            })


        });
    </script>
}
