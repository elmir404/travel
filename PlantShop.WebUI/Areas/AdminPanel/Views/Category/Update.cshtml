@model GetCategoryDto
@{
    ViewData["Title"] = "Update";
}
<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important;">
        <!-- Horizontal -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">Update Category</h3>
            </div>
            <div class="block-content block-content-full">
                <div class="row">
                    <div class="col-lg-12 space-y-5">
                        <!-- Form Horizontal - Default Style -->
                        <form class="space-y-4" method="POST">
                            <div>
                                <p class="field-error"><span asp-validation-for="AzName" class="text-danger"></span></p>
                                <p class="field-error"><span asp-validation-for="EnName" class="text-danger"></span></p>
                                <p class="field-error"><span asp-validation-for="RuName" class="text-danger"></span></p>
                            </div>
                            <div class="text-danger mb-2 "></div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Az Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.AzName" class="form-control" placeholder="Az Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">En Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.EnName" class="form-control" placeholder="En Name..">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label" for="example-hf-email">Ru Name</label>
                                <div class="col-sm-8">
                                    <input type="text" asp-for="@Model.RuName" class="form-control" placeholder="Ru Name..">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-8 ms-auto">
                                    <button type="submit" class="btn btn-primary">Update Category</button>
                                </div>
                            </div>
                        </form>
                        <!-- END Form Horizontal - Default Style -->
                    </div>
                </div>
            </div>
        </div>
        <!-- END Horizontal -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <style>
        .field-error {
            margin: 0px !important;
            font-style: italic;
            letter-spacing: 1px;
        }
    </style>
}