@model List<GetProductDto>
<main id="main-container">
    <!-- Page Content -->
    <div class="content" style="width: 100% !important">
        <!-- Dynamic Table Responsive -->
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">
                    Product Table <small>List</small>
                </h3>
            </div>
            <div class="block-content block-content-full">
                <!-- DataTables init on table by adding .js-dataTable-responsive class, functionality is initialized in js/pages/be_tables_datatables.min.js which was auto compiled from _js/pages/be_tables_datatables.js -->
                <table id="product-table" class="table table-bordered table-striped table-vcenter js-dataTable-responsive" style="margin: 10px 0px;">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Az Name</th>
                            <th style="width: 15%;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td class="fs-sm">@product.Id</td>
                                <td class="fw-semibold fs-sm">@product.AzName</td>
                                <td>
                                    <div class="btn-list">
                                        <button onclick=Detail(@product.Id) type="button" class="btn btn-sm btn-secondary"><i class="si si-menu"></i></button>
                                        <button onclick=Edit(@product.Id) type="button" class="btn btn-sm btn-primary"><i class="fa fa-refresh"></i></button>
                                        <button id="@product.Id" type="button" class="btn remove  btn-sm btn-danger"><span class="si si-trash"> </span></button>
                                        <button id="@product.Id" type="button" class="btn deactive  btn-sm btn-outline-danger" style="padding: 4px 5px;">Deactive</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Dynamic Table Responsive -->
    </div>
    <!-- END Page Content -->
</main>

@section Scripts{
    <script>
        function Detail(id) {
            location.href = `/AdminPanel/Product/Detail?Id=${id}`;
        }
        function Edit(id) {
            location.href = `/AdminPanel/Product/Update?Id=${id}`;
        }
        $('#product-table').on('click', '.remove', function () {
            var table = $('#product-table').DataTable();
            var id = $(this).attr("id");
            var thh = $(this);

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "DELETE",
                        url: `/AdminPanel/Product/Delete?Id=${id}`,
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire(
                                    'Deleted!',
                                    'Your file has been deleted.',
                                    'success'
                                ).then((result) => {
                                    if (result.isConfirmed) {
                                        table
                                            .row($(thh).parents('tr'))
                                            .remove()
                                            .draw(false);

                                    }
                                });

                            }
                            else {
                                alert(result.message)
                            }
                        }
                    });

                }
            })


        });
        $('#product-table').on('click', '.deactive', function () {
            var table = $('#product-table').DataTable();
            var id = $(this).attr("id");
            var thh = $(this);

            Swal.fire({
                title: 'Are you sure?',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, deactive it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "PATCH",
                        url: `/AdminPanel/Product/Deactive?Id=${id}`,
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire(
                                    'Deactived!',
                                    'Your file has been deactived.',
                                    'success'
                                ).then((result) => {
                                    if (result.isConfirmed) {
                                        table
                                            .row($(thh).parents('tr'))
                                            .remove()
                                            .draw(false);

                                    }
                                });

                            }
                            else {
                                alert(result.message)
                            }
                        }
                    });

                }
            })


        });
    </script>
      }